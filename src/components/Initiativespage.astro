---
import { getUrlWithBase } from '../utils/i18n';

const { data, lang } = Astro.props;

const check_svg = `<svg class="w-4 h-4 text-green-500 mr-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>`;

const icon_svgs: Record<string, string> = {
  cultural: `<svg class="w-8 h-8 text-white" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>`,
  education: `<svg class="w-8 h-8 text-white" fill="currentColor" viewBox="0 0 20 20"><path d="M9 4.804A7.968 7.968 0 005.5 4c-1.255 0-2.443.29-3.5.804v10A7.969 7.969 0 015.5 14c1.669 0 3.218.51 4.5 1.385A7.962 7.962 0 0114.5 14c1.255 0 2.443.29 3.5.804v-10A7.968 7.968 0 0014.5 4c-1.255 0-2.443.29-3.5.804V12a1 1 0 11-2 0V4.804z"></path></svg>`,
  community: `<svg class="w-8 h-8 text-white" fill="currentColor" viewBox="0 0 20 20"><path d="M13 6a3 3 0 11-6 0 3 3 0 016 0zM18 8a2 2 0 11-4 0 2 2 0 014 0zM14 15a4 4 0 00-8 0v3h8v-3z"></path></svg>`,
  youth: `<svg class="w-8 h-8 text-white" fill="currentColor" viewBox="0 0 20 20"><path d="M10 12a2 2 0 100-4 2 2 0 000 4z"></path><path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd"></path></svg>`,
  media: `<svg class="w-8 h-8 text-white" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M2 5a2 2 0 012-2h8a2 2 0 012 2v10a2 2 0 002 2H4a2 2 0 01-2-2V5zm3 1h6v4H5V6zm6 6H5v2h6v-2z" clip-rule="evenodd"></path></svg>`,
  outreach: `<svg class="w-8 h-8 text-white" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10c0 3.866-3.582 7-8 7a8.841 8.841 0 01-4.083-.98L2 17l1.338-3.123C2.493 12.767 2 11.434 2 10c0-3.866 3.582-7 8-7s8 3.134 8 7zM7 9H5v2h2V9zm8 0h-2v2h2V9zM9 9h2v2H9V9z" clip-rule="evenodd"></path></svg>`,
};
---

<!-- Page Header -->
<section class="bg-thamizhi-red-600 text-white py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
      <h1 class="text-4xl font-bold mb-4">{data.hero?.title || "Our Initiatives"}</h1>
      <p class="text-xl text-amber-100">{data.hero?.description}</p>
    </div>
  </div>
</section>

<!-- Initiatives Grid -->
<section class="py-16 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {data.sections?.map((section: any) => (
        <div class="bg-white rounded-lg shadow-sm p-8 hover:shadow-md transition-shadow">
          <div class:list={["w-16 h-16 rounded-lg flex items-center justify-center mb-6", section.color || "bg-thamizhi-red-600"]}>
            <Fragment set:html={icon_svgs[section.icon] || icon_svgs.cultural} />
          </div>
          <h3 class="text-2xl font-bold text-gray-900 mb-4">{section.title}</h3>
          <p class="text-gray-600 mb-6">{section.description}</p>
          <ul class="space-y-3">
            {section.items?.map((item: string) => (
              <li class="flex items-center text-gray-700">
                <Fragment set:html={check_svg} />
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- CTA Section -->
{data.cta && (
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-amber-50 rounded-lg p-8">
        <div class="max-w-3xl mx-auto text-center">
          <h2 class="text-2xl font-bold text-gray-900 mb-4">{data.cta.title}</h2>
          <p class="text-gray-600 mb-6">{data.cta.description}</p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href={getUrlWithBase('contact', lang)} class="bg-thamizhi-red-600 text-white px-8 py-3 rounded-lg font-medium hover:bg-thamizhi-red-700 transition-colors">
              {data.cta.contact_us}
            </a>
            <a href={getUrlWithBase('events', lang)} class="border border-thamizhi-red-600 text-thamizhi-red-600 px-8 py-3 rounded-lg font-medium hover:bg-thamizhi-red-600 hover:text-white transition-colors">
              {data.cta.view_events}
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
)}
