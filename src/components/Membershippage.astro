---
import { getUrlWithBase, loadUi } from '../utils/i18n';

const { data, lang } = Astro.props;
const { t } = await loadUi(lang);
---

<!-- Page Header -->
<section class="bg-thamizhi-red-600 text-white relative overflow-hidden">
  <div class="absolute inset-0 opacity-10">
    <div
      class="absolute top-0 left-0 w-full h-full"
      style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 20px 20px"
    />
  </div>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 relative">
    <div class="max-w-3xl">
      <h1 class="text-4xl lg:text-5xl font-bold mb-4">
        {data.hero?.title || "Become a Member"}
      </h1>
      <h2 class="text-2xl lg:text-3xl font-medium text-thamizhi-amber-100 mb-6">
        {data.hero?.subtitle || "Join Our Tamil Community"}
      </h2>
      <p class="text-xl text-thamizhi-amber-100">
        {data.hero?.description || ""}
      </p>
    </div>
  </div>
</section>

<!-- Membership Types -->
<section class="py-16 bg-slate-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-3xl font-bold text-gray-900 mb-4">
        {t('membership.plans')}
      </h2>
      <p class="text-lg text-gray-600">
        {t('membership.plans_desc')}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      {data.membership_types?.map((membership: any) => (
        <div class="bg-white rounded-lg shadow-lg p-6 hover:shadow-xl transition-shadow">
          <div class="text-center mb-6">
            <h3 class="text-xl font-bold text-gray-900 mb-2">{membership.name}</h3>
            {membership.name_tamil && (
              <h4 class="text-lg font-medium text-thamizhi-charcoal-800 mb-3">{membership.name_tamil}</h4>
            )}
            <div class="text-3xl font-bold text-thamizhi-charcoal-800 mb-1">{membership.price}</div>
            <div class="text-gray-500">{membership.duration}</div>
            {membership.duration_tamil && (
              <div class="text-sm text-gray-400">{membership.duration_tamil}</div>
            )}
          </div>

          <ul class="space-y-3 mb-8">
            {membership.benefits?.map((benefit: string) => (
              <li class="flex items-start">
                <svg class="h-5 w-5 text-green-500 mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
                <span class="text-gray-700">{benefit}</span>
              </li>
            ))}
          </ul>

          <button class="w-full bg-thamizhi-red-600 text-white py-2 px-4 rounded-lg hover:bg-thamizhi-red-700 transition-colors">
            {t('membership.apply_now')}
          </button>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Benefits Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-3xl font-bold text-gray-900 mb-4">
        {data.general_benefits?.title || "Membership Benefits"}
      </h2>
      <p class="text-lg text-gray-600">
        {data.general_benefits?.description || "What you get as a member"}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {data.general_benefits?.items?.map((benefit: any) => (
        <div class="bg-slate-50 rounded-lg p-6">
          <h3 class="text-xl font-semibold text-gray-900 mb-3">{benefit.title}</h3>
          {benefit.title_tamil && (
            <h4 class="text-lg font-medium text-thamizhi-charcoal-800 mb-3">{benefit.title_tamil}</h4>
          )}
          <p class="text-gray-700">{benefit.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Application Process -->
<section class="py-16 bg-slate-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-3xl font-bold text-gray-900 mb-4">
        {data.application_process?.title || "How to Apply"}
      </h2>
      <p class="text-lg text-gray-600">
        {data.application_process?.description || "Simple steps to join our community"}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      {data.application_process?.steps?.map((step: any) => (
        <div class="text-center">
          <div class="bg-thamizhi-red-600 text-white rounded-full w-12 h-12 flex items-center justify-center text-xl font-bold mx-auto mb-4">
            {step.step}
          </div>
          <h3 class="text-lg font-semibold text-gray-900 mb-2">{step.title}</h3>
          {step.title_tamil && (
            <h4 class="text-md font-medium text-thamizhi-charcoal-800 mb-2">{step.title_tamil}</h4>
          )}
          <p class="text-gray-600">{step.description}</p>
        </div>
      ))}
    </div>

    <div class="text-center mt-12">
      <button class="bg-thamizhi-red-600 text-white px-8 py-3 rounded-lg text-lg hover:bg-thamizhi-red-700 transition-colors">
        {t('membership.start_application')}
      </button>
    </div>
  </div>
</section>

<!-- Member Testimonials -->
{data.member_testimonials && (
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">
          {data.member_testimonials?.title || "What Our Members Say"}
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {data.member_testimonials?.testimonials?.map((testimonial: any) => (
          <div class="bg-slate-50 rounded-lg p-6">
            <div class="flex items-center mb-4">
              {Array(testimonial.rating).fill(0).map((_: any) => (
                <svg class="w-5 h-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>
            <p class="text-gray-700 mb-4 italic">"{testimonial.quote}"</p>
            <div>
              <p class="font-semibold text-gray-900">{testimonial.name}</p>
              {testimonial.name_tamil && (
                <p class="text-sm text-thamizhi-charcoal-800">{testimonial.name_tamil}</p>
              )}
              <p class="text-sm text-gray-600">{testimonial.membership_type}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<!-- FAQs -->
{data.faqs && (
  <section class="py-16 bg-slate-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">
          {data.faqs?.title || "Frequently Asked Questions"}
        </h2>
      </div>

      <div class="space-y-6">
        {data.faqs?.items?.map((faq: any) => (
          <div class="bg-white rounded-lg shadow-lg border-2 border-gray-300 p-6">
            <h3 class="text-lg font-semibold text-gray-900 mb-2">{faq.question}</h3>
            {faq.question_tamil && (
              <h4 class="text-md font-medium text-thamizhi-charcoal-800 mb-2">{faq.question_tamil}</h4>
            )}
            <p class="text-gray-700">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<!-- Contact Information -->
{data.contact && (
  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-gray-900 mb-4">
        {data.contact?.title || "Questions About Membership?"}
      </h2>
      <p class="text-lg text-gray-600 mb-8">
        {data.contact?.description || "Contact our membership team for more information"}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href={`mailto:${data.contact?.email}`}
          class="bg-thamizhi-red-600 text-white px-6 py-3 rounded-lg hover:bg-thamizhi-red-700 transition-colors"
        >
          {t('membership.email_us')}
        </a>
        <a
          href={`tel:${data.contact?.phone}`}
          class="bg-gray-600 text-white px-6 py-3 rounded-lg hover:bg-gray-700 transition-colors"
        >
          {t('membership.call_us')}
        </a>
      </div>

      {data.contact?.office_hours && (
        <div class="mt-8 bg-slate-50 rounded-lg p-6">
          <h3 class="text-lg font-semibold text-gray-900 mb-4">
            {t('membership.office_hours')}
          </h3>
          <div class="space-y-1">
            {data.contact.office_hours.map((hours: string) => (
              <p class="text-gray-600">{hours}</p>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>
)}

<!-- Call to Action -->
<section class="py-16 bg-thamizhi-red-600 text-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="text-3xl font-bold mb-4">
      {t('membership.ready_to_join')}
    </h2>
    <p class="text-xl text-thamizhi-amber-100 mb-8">
      {t('membership.ready_to_join_desc')}
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <button class="bg-white text-thamizhi-charcoal-800 px-8 py-3 rounded-lg font-medium hover:bg-slate-50 transition-colors">
        {t('membership.start_application')}
      </button>
      <a
        href={getUrlWithBase('/about', lang)}
        class="border-2 border-white text-white px-8 py-3 rounded-lg font-medium hover:bg-white hover:text-thamizhi-red-700 transition-colors"
      >
        {t('membership.learn_more_about_us')}
      </a>
    </div>
  </div>
</section>
