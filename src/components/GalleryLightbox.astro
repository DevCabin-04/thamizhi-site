---
interface GalleryImage {
  url: string;
  title?: string;
  caption?: string;
}

interface Album {
  id: string;
  title: string;
  title_tamil?: string;
  cover_image?: string;
  date?: string;
  location?: string;
  description?: string;
  photographer?: string;
  images: GalleryImage[];
}

interface Highlight {
  id: string;
  thumbnail: string;
  title: string;
  description?: string;
  date?: string;
}

interface Props {
  featured_albums: Album[];
  recent_highlights: Highlight[];
  lang: string;
}

const { featured_albums = [], recent_highlights = [], lang } = Astro.props;

const photosLabel = lang === 'ta' ? 'படங்கள்' : lang === 'si' ? 'ඡායාරූප' : 'Photos';
const featuredTitle = lang === 'ta' ? 'சிறப்பு ஆல்பங்கள்' : lang === 'si' ? 'විශේෂාංග ඇල්බම' : 'Featured Albums';
const featuredDesc =
  lang === 'ta'
    ? 'சமீபத்திய நிகழ்வு புகைப்படத் தொகுப்புகள்'
    : lang === 'si'
      ? 'මෑතකාලීන සිදුවීම් ඡායාරූප එකතු කිරීම්'
      : 'Recent event photo collections';
const recentTitle = lang === 'ta' ? 'சமீபத்திய சிறப்பம்சங்கள்' : lang === 'si' ? 'මෑත කාලීන ඉස්මතු කිරීම්' : 'Recent Highlights';
const recentDesc =
  lang === 'ta' ? 'எங்கள் சமூகத்தின் சமீபத்திய தருணங்கள்' : lang === 'si' ? 'අපගේ ප්‍රජාවේ මෑත අවස්ථා' : 'Latest moments from our community';
const viewAlbumText = lang === 'ta' ? 'ஆல்பத்தைக் காண்க' : lang === 'si' ? 'ඇල්බමය බලන්න' : 'View Album';

const getImageUrl = (p?: string | null) => (p ? p.replace(/ /g, '%20') : '');
const albumsJson = JSON.stringify(featured_albums);
---

{featured_albums.length > 0 && (
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">{featuredTitle}</h2>
        <p class="text-lg text-gray-600">{featuredDesc}</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {featured_albums.map((album, aIdx) => (
          <div class="bg-slate-50 rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition-shadow">
            <div class="h-48 bg-gray-200 relative overflow-hidden group cursor-pointer" data-open-album={aIdx} data-open-image="0">
              <img src={getImageUrl(album.cover_image || album.images?.[0]?.url)} alt={album.title} class="w-full h-full object-cover" />
              <div class="absolute inset-0 bg-black/0 group-hover:bg-black/30 transition-all flex items-center justify-center" />
              {album.date && <div class="absolute top-4 right-4 bg-black/60 text-white px-3 py-1 rounded text-sm">{album.date}</div>}
              {album.images?.length > 0 && <div class="absolute bottom-4 left-4 bg-black/60 text-white px-3 py-1 rounded text-sm">{album.images.length} {photosLabel}</div>}
            </div>
            <div class="p-6">
              <h3 class="text-xl font-bold text-gray-900 mb-1">{album.title}</h3>
              {album.title_tamil && <h4 class="text-lg font-medium text-thamizhi-red-600 mb-2">{album.title_tamil}</h4>}
              {album.location && <p class="text-sm text-gray-500 mb-2">📍 {album.location}</p>}
              {album.description && <p class="text-gray-700 mb-4">{album.description}</p>}
              {album.photographer && <p class="text-sm text-gray-500 mb-4">📷 {album.photographer}</p>}

              {album.images?.length > 0 && (
                <div class="grid grid-cols-4 gap-2 mb-4">
                  {album.images.slice(0, 4).map((img, iIdx) => (
                    <button class="aspect-square bg-gray-200 rounded overflow-hidden hover:opacity-75 transition-opacity" data-open-album={aIdx} data-open-image={iIdx}>
                      <img src={getImageUrl(img.url)} alt={img.title || album.title} class="w-full h-full object-cover" />
                    </button>
                  ))}
                </div>
              )}

              <button class="bg-thamizhi-red-600 text-white px-4 py-2 rounded-lg hover:bg-thamizhi-red-700 transition-colors w-full" data-open-album={aIdx} data-open-image="0" disabled={!album.images?.length}>
                {viewAlbumText}
              </button>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

{recent_highlights.length > 0 && (
  <section class="py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">{recentTitle}</h2>
        <p class="text-lg text-gray-600">{recentDesc}</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {recent_highlights.map((h) => (
          <button
            class="bg-white rounded-lg shadow-lg overflow-hidden hover:shadow-xl transition-shadow text-left"
            data-highlight-url={getImageUrl(h.thumbnail)}
            data-highlight-title={h.title}
            data-highlight-caption={h.description || ''}
          >
            <div class="h-40 bg-gray-200 overflow-hidden">
              <img src={getImageUrl(h.thumbnail)} alt={h.title} class="w-full h-full object-cover hover:scale-105 transition-transform duration-300" />
            </div>
            <div class="p-4">
              <h3 class="text-lg font-semibold text-gray-900 mb-2">{h.title}</h3>
              {h.description && <p class="text-gray-600 text-sm mb-2 line-clamp-2">{h.description}</p>}
              {h.date && <p class="text-xs text-gray-500">{h.date}</p>}
            </div>
          </button>
        ))}
      </div>
    </div>
  </section>
)}

<div id="gallery-lightbox" class="fixed inset-0 bg-black/90 z-50 hidden items-center justify-center p-4">
  <button id="gallery-close" class="absolute top-4 right-4 text-white hover:text-gray-300 z-10">✕</button>
  <button id="gallery-prev" class="absolute left-4 text-white hover:text-gray-300 z-10 text-3xl">‹</button>
  <button id="gallery-next" class="absolute right-4 text-white hover:text-gray-300 z-10 text-3xl">›</button>
  <div class="max-w-6xl max-h-full flex flex-col items-center" id="gallery-content">
    <img id="gallery-image" src="" alt="" class="max-w-full max-h-[80vh] object-contain rounded-lg shadow-2xl" />
    <div class="mt-4 text-white text-center max-w-2xl">
      <h3 id="gallery-title" class="text-xl font-semibold mb-2"></h3>
      <p id="gallery-caption" class="text-gray-300"></p>
    </div>
  </div>
</div>

<script is:inline define:vars={{ albumsJson }}>
  const albums = JSON.parse(albumsJson || '[]');
  const modal = document.getElementById('gallery-lightbox');
  const imgEl = document.getElementById('gallery-image');
  const titleEl = document.getElementById('gallery-title');
  const captionEl = document.getElementById('gallery-caption');
  const prevBtn = document.getElementById('gallery-prev');
  const nextBtn = document.getElementById('gallery-next');

  let currentAlbum = -1;
  let currentImage = -1;

  const setImage = (url, title = '', caption = '') => {
    if (!imgEl) return;
    imgEl.src = url;
    imgEl.alt = title || 'Gallery image';
    if (titleEl) titleEl.textContent = title;
    if (captionEl) captionEl.textContent = caption || '';
  };

  const openModal = () => {
    modal?.classList.remove('hidden');
    modal?.classList.add('flex');
  };

  const closeModal = () => {
    modal?.classList.add('hidden');
    modal?.classList.remove('flex');
  };

  document.querySelectorAll('[data-open-album]').forEach((el) => {
    el.addEventListener('click', () => {
      currentAlbum = Number(el.getAttribute('data-open-album'));
      currentImage = Number(el.getAttribute('data-open-image') || 0);
      const album = albums[currentAlbum];
      const image = album?.images?.[currentImage];
      if (!image) return;
      setImage((image.url || '').replace(/ /g, '%20'), image.title || album?.title || '', image.caption || '');
      openModal();
    });
  });

  document.querySelectorAll('[data-highlight-url]').forEach((el) => {
    el.addEventListener('click', () => {
      currentAlbum = -1;
      currentImage = -1;
      setImage(el.getAttribute('data-highlight-url') || '', el.getAttribute('data-highlight-title') || '', el.getAttribute('data-highlight-caption') || '');
      openModal();
    });
  });

  prevBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    if (currentAlbum < 0) return;
    const album = albums[currentAlbum];
    if (!album?.images?.length) return;
    currentImage = (currentImage - 1 + album.images.length) % album.images.length;
    const image = album.images[currentImage];
    setImage((image.url || '').replace(/ /g, '%20'), image.title || album.title || '', image.caption || '');
  });

  nextBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    if (currentAlbum < 0) return;
    const album = albums[currentAlbum];
    if (!album?.images?.length) return;
    currentImage = (currentImage + 1) % album.images.length;
    const image = album.images[currentImage];
    setImage((image.url || '').replace(/ /g, '%20'), image.title || album.title || '', image.caption || '');
  });

  document.getElementById('gallery-close')?.addEventListener('click', closeModal);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });
</script>
