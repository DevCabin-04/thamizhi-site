---
import { getUrlWithBase } from "../../utils/i18n.js";

export interface Props {
    items?: Array<{ name: string; href?: string }>;
    currentPage?: string;
    lang?: string;
}

const { items = [], currentPage, lang = "en" } = Astro.props;

const homeText = lang === "en" ? "Home" : lang === "ta" ? "முகப்பு" : "මුල් පිටුව";
---

<nav class="bg-white border-b border-gray-200" aria-label="Breadcrumb">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
        <ol class="flex items-center space-x-2 text-sm">
            <li>
                <a
                    href={getUrlWithBase("", lang)}
                    class="text-blue-900 hover:text-blue-800 transition-colors"
                >
                    {homeText}
                </a>
            </li>
            {items.map((item) => (
                <>
                    <li>
                        <svg
                            class="w-4 h-4 text-gray-400"
                            fill="currentColor"
                            viewBox="0 0 20 20"
                        >
                            <path
                                fill-rule="evenodd"
                                d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
                                clip-rule="evenodd"
                            />
                        </svg>
                    </li>
                    <li>
                        {item.href ? (
                            <a
                                href={item.href}
                                class="text-blue-900 hover:text-blue-800 transition-colors"
                            >
                                {item.name}
                            </a>
                        ) : (
                            <span class="text-gray-500">{item.name}</span>
                        )}
                    </li>
                </>
            ))}
            {currentPage && (
                <>
                    <li>
                        <svg
                            class="w-4 h-4 text-gray-400"
                            fill="currentColor"
                            viewBox="0 0 20 20"
                        >
                            <path
                                fill-rule="evenodd"
                                d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
                                clip-rule="evenodd"
                            />
                        </svg>
                    </li>
                    <li>
                        <span class="text-gray-700 font-medium">{currentPage}</span>
                    </li>
                </>
            )}
        </ol>
    </div>
</nav>
