---
import { languages, getUrlWithBase, supportedLangs } from '../../utils/i18n';

export interface Props {
  currentLang: string;
}

const { currentLang }: Props = Astro.props;

// Extract the current path without the lang prefix
const getPagePath = (url: URL): string => {
  let pathname = url.pathname;
  if (pathname.endsWith('/') && pathname !== '/') {
    pathname = pathname.slice(0, -1);
  }
  const parts = pathname.split('/').filter(Boolean);
  if (parts.length > 0 && supportedLangs.includes(parts[0] as (typeof supportedLangs)[0])) {
    parts.shift();
  }
  return parts.length > 0 ? `/${parts.join('/')}` : '';
};

const labels: Record<string, string> = {
  en: 'EN',
  ta: 'தமிழ்',
  si: 'සිං',
};

const pagePath = getPagePath(Astro.url);
const langEntries = Object.keys(languages);
---

<nav aria-label="Language selector" class="flex rounded overflow-hidden border border-thamizhi-amber-600/40">
  {langEntries.map((langCode, idx) => {
    const href = getUrlWithBase(pagePath, langCode);
    const isActive = currentLang === langCode;
    const borderClass = idx > 0 ? ' border-l border-thamizhi-amber-600/40' : '';
    return isActive ? (
      <a href={href} aria-current="page"
         class={`px-2.5 py-1 text-xs font-medium bg-thamizhi-amber-600 text-thamizhi-charcoal-800 no-underline${borderClass}`}>
        {labels[langCode] || langCode}
      </a>
    ) : (
      <a href={href}
         class={`px-2.5 py-1 text-xs font-medium text-thamizhi-amber-600 hover:bg-thamizhi-amber-600/20 no-underline${borderClass}`}>
        {labels[langCode] || langCode}
      </a>
    );
  })}
</nav>
