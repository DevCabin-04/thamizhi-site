---
// SearchBar component for government-style header
---

<div class="flex items-center">
    <form class="relative" action="/search" method="get">
        <div class="relative">
            <input
                type="search"
                name="q"
                placeholder="Search..."
                class="w-64 px-4 py-2 pl-10 text-sm text-white placeholder-[#f3d98d] bg-[#5a0c0c] border border-[#d4af37] rounded-md focus:outline-none focus:ring-2 focus:ring-[#d4af37] focus:border-transparent"
                aria-label="Search"
            />
            <div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none">
                <svg
                    class="w-4 h-4 text-[#f3d98d]"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
                    />
                </svg>
            </div>
        </div>
    </form>
</div>
