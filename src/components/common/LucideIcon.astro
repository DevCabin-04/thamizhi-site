---
interface Props {
  name: string;
  class?: string;
}

const { name, class: className = 'w-6 h-6' } = Astro.props;

const icons: Record<string, string> = {
  'book-open': `
    <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" />
    <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" />
  `,
  users: `
    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
    <circle cx="9" cy="7" r="4" />
    <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
    <path d="M16 3.13a4 4 0 0 1 0 7.75" />
  `,
  calendar: `
    <path d="M8 2v4" />
    <path d="M16 2v4" />
    <rect width="18" height="18" x="3" y="4" rx="2" />
    <path d="M3 10h18" />
  `,
  trophy: `
    <path d="M8 21h8" />
    <path d="M12 17v4" />
    <path d="M7 4h10v5a5 5 0 0 1-10 0z" />
    <path d="M5 9H4a2 2 0 0 1-2-2V5h3" />
    <path d="M19 9h1a2 2 0 0 0 2-2V5h-3" />
  `,
  mail: `
    <rect width="20" height="16" x="2" y="4" rx="2" />
    <path d="m22 7-10 6L2 7" />
  `,
  'user-plus': `
    <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
    <circle cx="8.5" cy="7" r="4" />
    <path d="M20 8v6" />
    <path d="M23 11h-6" />
  `,
  hand: `
    <path d="M6 12V5a1 1 0 0 1 2 0v6" />
    <path d="M10 11V4a1 1 0 0 1 2 0v7" />
    <path d="M14 12V6a1 1 0 0 1 2 0v8" />
    <path d="M18 14v-3a1 1 0 0 1 2 0v5a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5v-1" />
    <path d="m4 14 2 2" />
  `,
  sparkle: `
    <path d="M12 3l1.9 4.1L18 9l-4.1 1.9L12 15l-1.9-4.1L6 9l4.1-1.9z" />
    <path d="M19 3v4" />
    <path d="M21 5h-4" />
    <path d="M5 16v3" />
    <path d="M6.5 17.5h-3" />
  `,
  'badge-check': `
    <path d="M12 2l2.3 2.3 3.2-.2.2 3.2L20 10l-2.3 2.3.2 3.2-3.2.2L12 18l-2.3-2.3-3.2.2-.2-3.2L4 10l2.3-2.3-.2-3.2 3.2-.2z" />
    <path d="m9 10 2 2 4-4" />
  `,
  default: `
    <circle cx="12" cy="12" r="9" />
    <path d="m9 12 2 2 4-4" />
  `,
};

const svg = icons[name] ?? icons.default;
---

<svg
  class={className}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  set:html={svg}
></svg>
