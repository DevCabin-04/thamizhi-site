---
import { formatDate, getUrlWithBase, loadUi, getCategoryLabel } from '../utils/i18n';

interface Props {
  data: Record<string, unknown>;
  lang: string;
  blogPosts: Array<Record<string, unknown>>;
}

const { data, lang, blogPosts } = Astro.props;
const { t, ui } = await loadUi(lang);

const hero = data.hero as Record<string, string> | undefined;
const all_posts_section = data.all_posts_section as Record<string, string> | undefined;
---

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
  <!-- Hero -->
  <div class="text-center mb-16">
    <h1 class="text-4xl lg:text-5xl font-bold text-gray-900 mb-6">
      {hero?.title || t('blog.title')}
    </h1>
    {hero?.subtitle && (
      <p class="text-xl text-gray-600 max-w-3xl mx-auto mb-4">{hero.subtitle}</p>
    )}
    {hero?.description && (
      <p class="text-lg text-gray-600 max-w-3xl mx-auto">{hero.description}</p>
    )}
  </div>

  <!-- Posts grid -->
  {blogPosts && blogPosts.length > 0 ? (
    <div>
      <h2 class="text-3xl font-bold text-gray-900 mb-8">
        {all_posts_section?.title || t('blog.all_posts')}
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {blogPosts.map((post) => (
          <a
            href={getUrlWithBase(`blog/${post.slug as string}`, lang)}
            class="bg-white border-2 border-gray-200 overflow-hidden hover:border-thamizhi-red-600 hover:shadow-lg transition-all group"
          >
            {(post.featured_image as string) && (
              <div class="aspect-video bg-gray-200">
                <img
                  src={post.featured_image as string}
                  alt={post.title as string}
                  class="w-full h-full object-cover"
                />
              </div>
            )}
            <div class="p-6">
              <div class="flex items-center gap-2 mb-3">
                {(post.category as string) && (
                  <span class="text-xs font-semibold text-thamizhi-red-600 uppercase">
                    {getCategoryLabel(ui, post.category as string)}
                  </span>
                )}
                {post.published_date && (
                  <span class="text-xs text-gray-500">
                    {formatDate(post.published_date as string | Date, lang)}
                  </span>
                )}
              </div>
              <h3 class="text-xl font-bold text-gray-900 mb-2 group-hover:text-thamizhi-red-600">
                {post.title as string}
              </h3>
              <p class="text-gray-600 mb-4 line-clamp-3">{post.excerpt as string}</p>
              <div class="flex items-center text-thamizhi-red-600 font-semibold group-hover:gap-2 transition-all">
                {t('blog.read_more')}
                <svg class="w-4 h-4 ml-1 group-hover:ml-2 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  ) : (
    <div class="text-center py-16">
      <svg class="w-16 h-16 text-gray-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
      </svg>
      <p class="text-xl text-gray-600">{t('blog.no_posts')}</p>
      <p class="text-gray-500 mt-2">{t('blog.coming_soon')}</p>
    </div>
  )}
</div>
