---
interface Announcement {
  title: string;
  content: string;
  priority: 'high' | 'medium' | 'low';
}

interface Props {
  announcements: Announcement[];
}

const { announcements = [] } = Astro.props;
if (!announcements.length) return null;

const priority = announcements[0].priority;
const bannerClass =
  priority === 'high'
    ? 'bg-thamizhi-red-600 border-thamizhi-red-700'
    : priority === 'medium'
      ? 'bg-thamizhi-red-700 border-thamizhi-red-900'
      : 'bg-thamizhi-charcoal-700 border-thamizhi-charcoal-900';
---

<div id="announcement-banner" class={`border-b-2 ${bannerClass}`}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
    <div class="flex items-start justify-between gap-4">
      <div class="flex-1">
        {announcements.slice(0, 2).map((announcement, index) => (
          <div class={`flex items-start gap-3 ${index > 0 ? 'mt-3 pt-3 border-t border-white/20' : ''}`}>
            <div class="flex-shrink-0 mt-1">
              <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
              </svg>
            </div>
            <div class="flex-1">
              <h3 class="text-sm font-bold text-white mb-1">{announcement.title}</h3>
              <p class="text-sm text-white/95">{announcement.content}</p>
            </div>
          </div>
        ))}
      </div>
      <button id="announcement-close" class="flex-shrink-0 text-white hover:text-white/80 transition-colors p-1 rounded hover:bg-white/10" aria-label="Close announcements">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>
</div>

<script>
  const btn = document.getElementById('announcement-close');
  const banner = document.getElementById('announcement-banner');
  btn?.addEventListener('click', () => {
    banner?.remove();
  });
</script>
