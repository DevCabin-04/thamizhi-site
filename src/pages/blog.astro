---
// Redirect /blog to /en/blog (default language)
const getUrlWithBase = (href:string) => {
    const isDev = import.meta.env.NODE_ENV !== 'production';
    const basePath = ''; // No base path for Vercel

    return href ? `${basePath}/en/${href}` : href;
};
return Astro.redirect(getUrlWithBase('blog'), 301);
---
