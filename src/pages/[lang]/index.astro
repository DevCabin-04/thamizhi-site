---
import Layout from '../../layouts/Layout.astro';
import HomePage from '../../components/Homepage.astro';
import { loadContent, defaultLang, supportedLangs } from '../../utils/i18n';

export function getStaticPaths() {
  return supportedLangs.map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props;
const current_lang = lang || defaultLang;

const [data, site_config] = await Promise.all([
  loadContent(current_lang, 'home'),
  loadContent(current_lang, 'site_config'),
]);

const org = site_config.organization as Record<string, string> | undefined;
const meta = site_config.meta as Record<string, string> | undefined;
const hero = data.hero as Record<string, string> | undefined;
---

<Layout
  title={`${org?.name} - ${org?.tagline}`}
  description={hero?.description || meta?.description}
  lang={current_lang}
>
  <HomePage data={data} lang={current_lang} />
</Layout>
