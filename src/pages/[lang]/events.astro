---
import Layout from '../../layouts/Layout.astro';
import EventsPage from '../../components/Eventspage.astro';
import InitiativesPage from '../../components/Initiativespage.astro';
import PublicationsPage from '../../components/Publicationspage.astro';
import { loadContent, defaultLang, supportedLangs } from '../../utils/i18n';

export function getStaticPaths() {
  return supportedLangs.map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props;
const current_lang = lang || defaultLang;

const [eventsData, initiativesData, publicationsData, site_config] = await Promise.all([
  loadContent(current_lang, 'events'),
  loadContent(current_lang, 'initiatives'),
  loadContent(current_lang, 'publications'),
  loadContent(current_lang, 'site_config'),
]);

const org = site_config.organization as Record<string, string> | undefined;
const hero = eventsData.hero as Record<string, string> | undefined;
---

<Layout
  title={`${hero?.title || 'Events'} - ${org?.name}`}
  description={hero?.description}
  lang={current_lang}
>
  <EventsPage data={eventsData} lang={current_lang} />
  <section id="initiatives">
    <InitiativesPage data={initiativesData} lang={current_lang} />
  </section>
  <section id="publications">
    <PublicationsPage data={publicationsData} lang={current_lang} />
  </section>
</Layout>
