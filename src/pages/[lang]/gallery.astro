---
import Layout from '../../layouts/Layout.astro';
import GalleryPage from '../../components/Gallerypage.astro';
import { loadContent, defaultLang, supportedLangs } from '../../utils/i18n';

export function getStaticPaths() {
  return supportedLangs.map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props;
const current_lang = lang || defaultLang;

const [data, site_config] = await Promise.all([
  loadContent(current_lang, 'gallery'),
  loadContent(current_lang, 'site_config'),
]);
const org = site_config.organization as Record<string, string> | undefined;
const hero = data.hero as Record<string, string> | undefined;
---

<Layout
  title={`${hero?.title || 'Gallery'} - ${org?.name}`}
  description={hero?.description}
  lang={current_lang}
>
  <GalleryPage data={data} lang={current_lang} />
</Layout>
