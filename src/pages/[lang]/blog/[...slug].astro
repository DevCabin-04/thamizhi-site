---
import Layout from '../../../layouts/Layout.astro';
import BlogPost from '../../../components/BlogPost.astro';
import { getCollection } from 'astro:content';
import { supportedLangs, defaultLang } from '../../../utils/i18n';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');

  // Build a map: slug → entry per language
  const bySlug = new Map<string, Map<string, (typeof allPosts)[0]>>();

  for (const post of allPosts) {
    // id format: "en/welcome.md" or "ta/post.md"
    const parts = post.id.split('/');
    const postLang = parts.length > 1 ? parts[0] : 'en';
    const normalizedSlug =
      (post.data.route_slug as string) || parts[parts.length - 1].replace(/\.md$/, '');

    if (!bySlug.has(normalizedSlug)) bySlug.set(normalizedSlug, new Map());
    bySlug.get(normalizedSlug)!.set(postLang, post);
  }

  const paths: Array<{
    params: { lang: string; slug: string };
    props: { entry: (typeof allPosts)[0]; lang: string };
  }> = [];

  for (const lang of supportedLangs) {
    for (const [slug, langMap] of bySlug) {
      // Use native language post if available, else fall back to default, then EN
      const entry =
        langMap.get(lang) ??
        langMap.get(defaultLang) ??
        langMap.get('en') ??
        [...langMap.values()][0];

      if (entry) {
        paths.push({ params: { lang, slug }, props: { entry, lang } });
      }
    }
  }

  return paths;
}

const { lang } = Astro.params;
const { entry } = Astro.props;

const page_title = entry.data.title || 'Blog Post';
const postData = {
  ...entry.data,
  content: entry.rendered?.html ?? entry.body ?? '',
};
---

<Layout title={page_title} lang={lang}>
  <BlogPost data={postData} lang={lang} />
</Layout>
