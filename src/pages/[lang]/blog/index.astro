---
import Layout from '../../../layouts/Layout.astro';
import BlogPageIndex from '../../../components/BlogPageIndex.astro';
import { getCollection } from 'astro:content';
import { loadContent, supportedLangs } from '../../../utils/i18n';

export function getStaticPaths() {
  return supportedLangs.map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props;

// Fetch blog posts for this language, falling back to English posts
const allPosts = await getCollection('blog');

// Posts in this language
const langPosts = allPosts.filter((p) => {
  const postLang = (p.data.lang as string) || p.id.split('/')[0];
  return postLang === lang;
});

// If no posts in this language, show English posts as fallback
const posts = langPosts.length > 0
  ? langPosts
  : allPosts.filter((p) => {
      const postLang = (p.data.lang as string) || p.id.split('/')[0];
      return postLang === 'en';
    });

// Sort by date descending
posts.sort(
  (a, b) =>
    new Date(b.data.published_date ?? 0).getTime() -
    new Date(a.data.published_date ?? 0).getTime(),
);

// Normalise post shape for the component
const blogPosts = posts.map((p) => ({
  ...p.data,
  slug: (p.data.route_slug as string) || p.id.replace(/^[^/]+\//, '').replace(/\.md$/, ''),
}));

const [data, site_config] = await Promise.all([
  loadContent(lang, 'blog_page'),
  loadContent(lang, 'site_config'),
]);
const org = site_config.organization as Record<string, string> | undefined;
const hero = data.hero as Record<string, string> | undefined;
const page_title = hero?.title || 'Blog';
---

<Layout title={`${page_title} - ${org?.name}`} lang={lang}>
  <BlogPageIndex data={data} lang={lang} blogPosts={blogPosts} />
</Layout>
