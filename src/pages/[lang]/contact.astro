---
import Layout from "../../layouts/Layout.astro";
import ContactPage from "../../components/Contactpage.jsx";
import { getLangFromUrl, loadTina, loadContent, defaultLang, supportedLangs } from "../../utils/i18n.js";

// Static Path Generation for supported languages
export async function getStaticPaths() {
  return supportedLangs.map((lang) => ({
    params: { lang },
    props: { lang },
  }));
}

// Get language from props
const { lang } = Astro.props;
const currentLang = lang || defaultLang;

// Load TinaCMS data for the contact page
const pageResponse = await loadTina(currentLang, "contact");
const siteConfig = await loadContent(currentLang, "site_config");

const tinaProps = {
  data: pageResponse.data,
  query: pageResponse.query,
  variables: pageResponse.variables,
};

const contactData = (pageResponse.data as any)[`contact_${currentLang}`] || {};
---

<Layout
  title={`${contactData.hero?.title || "Contact Us"} - ${siteConfig.organization?.name}`}
  description={contactData.hero?.description || "Get in touch with us for assistance, information, or to provide feedback on our services."}
  lang={currentLang}
>
  <ContactPage
    props={tinaProps}
    lang={currentLang}
    client:load
  />
</Layout>

