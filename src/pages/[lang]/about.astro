---
import Layout from '../../layouts/Layout.astro';
import AboutPage from '../../components/Aboutpage.astro';
import MembershipPage from '../../components/Membershippage.astro';
import ContactPage from '../../components/Contactpage.astro';
import { loadContent, defaultLang, supportedLangs } from '../../utils/i18n';

export function getStaticPaths() {
  return supportedLangs.map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props;
const current_lang = lang || defaultLang;

const [aboutData, membershipData, contactData, site_config] = await Promise.all([
  loadContent(current_lang, 'about'),
  loadContent(current_lang, 'membership'),
  loadContent(current_lang, 'contact'),
  loadContent(current_lang, 'site_config'),
]);

const org = site_config.organization as Record<string, string> | undefined;
const hero = aboutData.hero as Record<string, string> | undefined;
---

<Layout
  title={`${hero?.title || 'About'} - ${org?.name}`}
  description={hero?.description}
  lang={current_lang}
>
  <AboutPage data={aboutData} lang={current_lang} />
  <section id="membership">
    <MembershipPage data={membershipData} lang={current_lang} />
  </section>
  <section id="contact">
    <ContactPage data={contactData} lang={current_lang} />
  </section>
</Layout>
