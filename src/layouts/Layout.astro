---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import {
  getLangFromUrl,
  loadContent,
  loadUi,
  getLocalizedUrl,
  getUrlWithBase,
  languages,
} from '../utils/i18n';
import LanguageSwitcher from '../components/common/LanguageSwitcher.astro';

export interface Props {
  title?: string;
  description?: string;
  lang?: string;
}

const { title, description, lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);

// Load site configuration and UI strings
const [siteConfig, { t }] = await Promise.all([
  loadContent(currentLang, 'site_config'),
  loadUi(currentLang),
]);

const pageTitle =
  title ||
  (siteConfig.meta as Record<string, string>)?.title_suffix ||
  (siteConfig.organization as Record<string, string>)?.name;

const pageDescription =
  description ||
  (siteConfig.meta as Record<string, string>)?.description ||
  (siteConfig.organization as Record<string, string>)?.description;

const org = siteConfig.organization as Record<string, string> | undefined;
const contact = siteConfig.contact as Record<string, unknown> | undefined;
const nav = siteConfig.navigation as {
  primary?: Array<{ name: string; href: string }>;
  footer?: Array<{ name: string; href: string }>;
} | undefined;
const footerData = siteConfig.footer as Record<string, string> | undefined;
const social = (contact?.social_media as Record<string, string>) ?? {};
const address = (contact?.address as {
  street?: string;
  city?: string;
  state?: string;
  postal_code?: string;
} | undefined) ?? undefined;
---

<!doctype html>
<html lang={currentLang} dir={languages[currentLang as keyof typeof languages]?.dir ?? 'ltr'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={pageDescription} />
    <meta property="og:image" content="/og-image.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/thamizhi.svg" />
    <title>{pageTitle}</title>
    <meta name="robots" content="index, follow" />
    <meta name="author" content={(siteConfig.meta as Record<string,string>)?.author || org?.name} />
    <meta name="keywords" content={(siteConfig.meta as Record<string,string>)?.keywords} />

    <!-- Language alternate links -->
    {
      Object.keys(languages).map((langCode) => (
        <link
          rel="alternate"
          hreflang={langCode}
          href={getLocalizedUrl(Astro.url, langCode)}
        />
      ))
    }

    <!-- Tamil / Sinhala fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@300;400;500;600;700&family=Noto+Sans+Tamil:wght@300;400;500;600;700&family=Noto+Sans+Sinhala:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- View Transitions -->
    <ClientRouter />
  </head>
  <body class="min-h-screen bg-white font-sans antialiased">
    <header class="bg-white shadow-sm">
      <!-- Utility bar -->
      <div class="bg-thamizhi-red-600 text-white py-2">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="flex justify-between items-center">
            <div class="text-xs text-gray-300">{org?.tagline}</div>
            <div class="flex items-center space-x-6">
              <LanguageSwitcher currentLang={currentLang} />
            </div>
          </div>
        </div>
      </div>

      <!-- Main nav -->
      <nav class="bg-white border-b border-gray-200 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center py-4">
          <!-- Logo -->
          <div class="flex items-center space-x-4">
            <a href={getUrlWithBase('', currentLang)} class="flex items-center">
              <img src="/thamizhi.svg" alt="Thamizhi logo" class="w-12 h-12 object-contain" />
              <div class="ml-3 text-xl font-bold text-gray-900">{org?.name}</div>
            </a>
          </div>

          <!-- Desktop nav links -->
          <div class="hidden md:flex items-center space-x-8">
            {
              nav?.primary?.map((item) => (
                <a
                  href={getUrlWithBase(item.href, currentLang)}
                  class="text-gray-700 hover:text-thamizhi-red-600 font-medium transition-colors duration-200 relative group"
                >
                  {item.name}
                  <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-thamizhi-red-600 transition-all duration-200 group-hover:w-full" />
                </a>
              ))
            }
          </div>

          <!-- Mobile menu button -->
          <div class="md:hidden">
            <button
              type="button"
              class="text-gray-700 hover:text-thamizhi-red-600 transition-colors"
              id="mobile-menu-button"
            >
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
              </svg>
            </button>
          </div>
        </div>

        <!-- Mobile nav menu -->
        <div class="md:hidden hidden" id="mobile-menu">
          <div class="px-2 pt-2 pb-3 space-y-1 bg-white border-t border-gray-200">
            {
              nav?.primary?.map((item) => (
                <a
                  href={getUrlWithBase(item.href, currentLang)}
                  class="block px-3 py-2 text-gray-700 hover:text-thamizhi-red-600 hover:bg-thamizhi-red-100 rounded-md font-medium transition-colors"
                >
                  {item.name}
                </a>
              ))
            }
          </div>
        </div>
      </nav>
    </header>

    <!-- Breadcrumb slot -->
    <slot name="breadcrumb" />

    <main class="flex-1">
      <slot />
    </main>

    <footer class="bg-thamizhi-red-600 text-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
          <!-- Org info -->
          <div class="md:col-span-2">
            <div class="flex items-center mb-4">
              <img src="/thamizhi.svg" alt="Thamizhi logo" class="w-10 h-10 object-contain" />
              <div class="ml-3 text-lg font-bold">{org?.name}</div>
            </div>
            <p class="text-gray-300 text-sm max-w-md mb-4">
              {footerData?.description ?? org?.description}
            </p>
            <div class="text-xs text-gray-400">
              <p>{t('footer.founded')} {org?.founded}</p>
            </div>
          </div>

          <!-- Quick links -->
          <div>
            <h3 class="text-white font-semibold mb-4">{t('footer.quick_links')}</h3>
            <ul class="space-y-2 text-sm">
              {
                nav?.footer?.map((item) => (
                  <li>
                    <a
                      href={getUrlWithBase(item.href, currentLang)}
                      class="text-gray-300 hover:text-white transition-colors"
                    >
                      {item.name}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>

          <!-- Contact info -->
          <div>
            <h3 class="text-white font-semibold mb-4">{t('footer.contact_us')}</h3>
            <ul class="space-y-2 text-sm text-gray-300">
              {
                (contact?.email as string) && (
                  <li>
                    <a
                      href={`mailto:${contact?.email}`}
                      class="hover:text-white transition-colors"
                    >
                      {contact?.email as string}
                    </a>
                  </li>
                )
              }
              {
                (contact?.phone as string) && (
                  <li>
                    <a
                      href={`tel:${contact?.phone}`}
                      class="hover:text-white transition-colors"
                    >
                      {contact?.phone as string}
                    </a>
                  </li>
                )
              }
              {address?.city && (
                <li class="text-xs">
                  {address.street && (<>{address.street}<br /></>)}
                  {address.city}{address.state ? `, ${address.state}` : ''}{address.postal_code ? ` ${address.postal_code}` : ''}
                </li>
              )}
            </ul>

            <!-- Social links -->
            <div class="mt-4 flex space-x-3">
              {
                social.facebook && (
                  <a
                    href={social.facebook}
                    class="text-gray-400 hover:text-white transition-colors"
                    aria-label={t('aria.facebook')}
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" />
                    </svg>
                  </a>
                )
              }
              {
                (contact?.email as string) && (
                  <a
                    href={`mailto:${contact?.email}`}
                    class="text-gray-400 hover:text-white transition-colors"
                    aria-label={t('aria.email')}
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect width="20" height="16" x="2" y="4" rx="2" />
                      <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
                    </svg>
                  </a>
                )
              }
            </div>
          </div>
        </div>

        <div class="border-t border-gray-700 mt-8 pt-8 text-center text-sm text-gray-300">
          <p>{footerData?.copyright}</p>
        </div>
      </div>
    </footer>

    <script>
      function setupMobileMenu() {
        const button = document.getElementById('mobile-menu-button');
        const menu = document.getElementById('mobile-menu');
        if (!button || !menu) return;

        // Clone button to remove stale listeners
        const fresh = button.cloneNode(true) as HTMLElement;
        button.parentNode?.replaceChild(fresh, button);

        const btn = document.getElementById('mobile-menu-button')!;
        const mnu = document.getElementById('mobile-menu')!;

        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          mnu.classList.toggle('hidden');
        });

        document.addEventListener('click', (e) => {
          if (!btn.contains(e.target as Node) && !mnu.contains(e.target as Node)) {
            mnu.classList.add('hidden');
          }
        });

        mnu.querySelectorAll('a').forEach((a) =>
          a.addEventListener('click', () => mnu.classList.add('hidden')),
        );
      }

      document.addEventListener('DOMContentLoaded', setupMobileMenu);
      document.addEventListener('astro:page-load', setupMobileMenu);
    </script>
  </body>
</html>
